{
    "name": "assessment-studio",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "concurrently --kill-others --names api,web \"npm run dev:api\" \"npm run dev:web\"",
        "dev:api": "tsx watch server/index.ts",
        "dev:web": "vite --host 127.0.0.1 --port 5174",
        "build": "npm run typecheck && vite build",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "tsx --test tests/*.test.ts",
        "test:core": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/core.test.ts",
        "preview": "vite preview --host 127.0.0.1",
        "start": "tsx server/index.ts",
        "format": "prettier --write src server shared tests"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.90.0",
        "express": "^5.1.0",
        "lucide-react": "^0.468.0",
        "mammoth": "^1.9.0",
        "multer": "^2.0.2",
        "openai": "6.44.0",
        "pdf-parse": "^2.4.5",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-markdown": "^10.1.0",
        "react-router": "^7.9.0",
        "remark-gfm": "^4.0.1",
        "zod": "^4.1.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.0",
        "@types/express": "^5.0.3",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.15.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^4.7.0",
        "concurrently": "^9.2.0",
        "prettier": "^3.6.0",
        "tailwindcss": "^4.1.0",
        "tsx": "^4.20.0",
        "typescript": "^5.9.0",
        "vite": "^6.3.0"
    }
}
