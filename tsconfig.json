{
    "compilerOptions": {
        "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
        "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
        "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
        "types": ["node", "vite/client"], "paths": {"@/*": ["./src/*"]}
    },
    "include": ["src", "server", "shared", "tests", "vite.config.ts"]
}
